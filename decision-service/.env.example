# Optional: without a key the service uses template reasoning instead of an LLM
OPENAI_API_KEY=
# Changing the model? Bump NEWS_JUDGMENT_VERSION in app/agent.py, or backtests reuse the old model's news judgments
LLM_MODEL=gpt-6-luna
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
POLYGON_API_KEY=
FINNHUB_API_KEY=

# News vector store (Postgres + pgvector, the news-db container). This default matches docker-compose.yml.
NEWS_DATABASE_URL=postgresql://news:news@news-db:5432/news

# --- Optional monitoring ---
SENTRY_DSN=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=trading-decision

# --- Langfuse LLM tracing ---
LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
LANGFUSE_SECRET_KEY=sk-lf-local-dev
LANGFUSE_HOST=http://langfuse:3000
