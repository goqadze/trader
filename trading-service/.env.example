DECISION_SERVICE_URL=http://decision-service:8000

# History database: the trading-db Postgres container from docker-compose.yml.
# (A SQLite URL such as sqlite:////data/trading.db still works for quick experiments.)
DATABASE_URL=postgresql+psycopg://trading:trading@trading-db:5432/trading

# --- Scheduler timing (New York market time) ---
# Decide 30 min before the close (15:30 ET): matches the news cutoff and the backtest's close fills
DECISION_MINUTES_BEFORE_CLOSE=30
# Bots set to "Check at: after the open" (or "both") decide this long after the open (30 = 10:00 ET),
# skipping the opening minutes' jumpy prices and wide spreads
DECISION_MINUTES_AFTER_OPEN=30
# How often open positions are checked against their stop-loss / target during market hours
RISK_CHECK_MINUTES=5
SCHEDULER_ENABLED=true

# --- Alpaca paper trading (optional): https://app.alpaca.markets -> Paper account -> API keys ---
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET_KEY=

# --- REAL MONEY. Leave false until the strategy has run on paper for weeks. ---
ALLOW_LIVE_TRADING=false
ALPACA_LIVE_KEY_ID=
ALPACA_LIVE_SECRET_KEY=

# --- Sign-in ---
# Signs the session tokens. Any long random string: openssl rand -hex 32. Changing it signs everyone out.
JWT_SECRET=
# How long "Keep me signed in" keeps a browser signed in (days). Each visit renews it.
SESSION_DAYS=30
# Set to true once the dashboard is served over HTTPS (Tailscale serve, Caddy, ...).
COOKIE_SECURE=false

# --- Email alerts (optional): buys, sells, stop-losses, blacklists, errors. Who gets them and about what is set on
# the dashboard (account menu -> Email alerts). Any SMTP server; Gmail shown. Gmail needs an App Password (2-Step
# Verification on, then https://myaccount.google.com/apppasswords), not your normal password. Port 587 also works on
# a new Hetzner server, which blocks 25 and 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# The sender shown; empty = SMTP_USERNAME. e.g. Trading bot <you@gmail.com>
SMTP_FROM=
# starttls (port 587) | ssl (port 465) | none
SMTP_SECURITY=starttls
# Where the emails' "Open in the dashboard" links point
DASHBOARD_URL=http://localhost:8080

SENTRY_DSN=
