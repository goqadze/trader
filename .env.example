# Settings docker-compose.yml reads itself (the services' own settings are in each service's .env).
# Copy to .env and fill in; .env is git-ignored.

# pgAdmin's login password (the login is admin@local.dev). Used when pgAdmin first starts: to change it
# later, use pgAdmin's own "Change Password" menu, or reset pgAdmin (see README, Trading database).
PGADMIN_PASSWORD=
