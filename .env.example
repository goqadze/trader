# Settings docker-compose.yml reads itself (the services' own settings are in each service's .env).
# Copy to .env and fill in; .env is git-ignored.

# pgAdmin's login password (the login is admin@local.dev). Used when pgAdmin first starts: to change it
# later, use pgAdmin's own "Change Password" menu, or reset pgAdmin (see README, Trading database).
PGADMIN_PASSWORD=

# --- On a server only (DEPLOY.md). Leave these out on the laptop. ---
# Use docker-compose.server.yml for every `docker compose` command, without typing -f
# COMPOSE_FILE=docker-compose.server.yml
# What runs besides the bots and the dashboard: news, backtest, monitoring, pgadmin, full (all four), public (Caddy).
# Comma-separated, e.g. news or news,public. Empty: just the bots and the dashboard.
# COMPOSE_PROFILES=news
# The public profile: the domain pointing at this server, served over HTTPS by Caddy
# DOMAIN=trading.example.com
